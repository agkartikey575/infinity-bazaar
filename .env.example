# Copy to .env.local for local runs. Never commit real values.
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox.
# Without these, the deal room runs with simulated PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: key that signs the payment ledger. Defaults to one derived from the PayPal secret.
LEDGER_SECRET=
# Optional: live AI voices. With a Claude API key (console.anthropic.com), Claude rewrites
# each deal's chat lines in character; the engine still sets every price and outcome.
# Without it, the deal room plays its original lines.
ANTHROPIC_API_KEY=
# Model for the voices. Default claude-haiku-5-5 (fast, low cost); claude-opus-5-5 writes richer lines but is slower and costs more.
VOICE_MODEL=
# Most Claude requests per day (UTC), retries included, per server instance. Over it, the
# original lines play. On serverless hosting each instance keeps its own counter. Default 300.
VOICE_DAILY_LIMIT=
# Most new Claude calls per visitor IP over 24 hours, per server instance. Default 30.
# Visitor IPs are read only on Vercel; under plain `next start` all visitors share one limit.
VOICE_PER_IP_LIMIT=
