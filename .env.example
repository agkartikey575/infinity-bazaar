# Copy to .env.local for local runs. Never commit real values.
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox.
# Without these, the deal room runs with simulated PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: key that signs the payment ledger. Defaults to one derived from the PayPal secret.
LEDGER_SECRET=
