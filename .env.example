# Copy to .env.local for local runs. Never commit real values.
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox.
# Without these, the deal room runs with simulated PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: key that signs the payment ledger. Defaults to one derived from the PayPal secret.
LEDGER_SECRET=
# Optional: live AI voices. With a Claude API key (console.anthropic.com), Claude rewrites
# each deal's chat lines in character; the engine still sets every price and outcome.
# Without it, the deal room plays its original lines.
ANTHROPIC_API_KEY=
# Model for the voices. Default claude-opus-5-5; claude-haiku-5-5 is faster and cheaper.
VOICE_MODEL=
# Most Claude calls per server per day (UTC). Over it, the original lines play. Default 300.
VOICE_DAILY_LIMIT=
